rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unspecified routes
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "simeonjrpictures123@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSupervisor() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'supervisor'])
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connection doc used to verify Firestore connectivity
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSupervisor());
      allow list: if isSupervisor();
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.email is string
        && request.resource.data.full_name is string
        && request.resource.data.role is string;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Forms Collection
    match /forms/{formId} {
      // Anyone signed in can read forms (for enumerators to download surveys)
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isSupervisor() || isAdmin())
        && request.resource.data.title is string
        && request.resource.data.version is string;
      allow update: if isSignedIn() && (isSupervisor() || isAdmin());
      allow delete: if isAdmin();
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow get: if isSignedIn() && (
        resource.data.enumerator_id == request.auth.uid ||
        isSupervisor()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.enumerator_id == request.auth.uid
        && request.resource.data.form_id is string
        && request.resource.data.status in ['pending_review', 'approved', 'rejected', 'flagged'];
      allow update: if isSignedIn() && (
        // Supervisors can update status and supervisor_notes
        (isSupervisor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'supervisor_notes', 'synced_at'])) ||
        // Enumerator can update their own pending submission
        (resource.data.enumerator_id == request.auth.uid && resource.data.status == 'pending_review') ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Cases Collection
    match /cases/{caseId} {
      allow get, list: if isSignedIn();
      allow create: if isSupervisor();
      allow update: if isSignedIn() && (
        isSupervisor() ||
        (resource.data.assigned_enumerator_id == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'last_visited_at', 'submission_id']))
      );
      allow delete: if isAdmin();
    }

    // Quality Audits Collection
    match /quality_audits/{auditId} {
      allow read: if isSignedIn();
      allow write: if isSupervisor();
    }
  }
}
